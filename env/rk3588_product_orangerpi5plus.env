# RK3588 Orange Pi 5 Plus Environment Configuration
# Target: Rockchip RK3588 SoC
# Board: Orange Pi 5 Plus
# OS: Ubuntu 22.04.5 Server (6.1.43 kernel)
#
# 使用方式:
#   1. source env/rk3588_product_orangerpi5plus.env
#   2. 如需切换工具链，先 export TOOLCHAIN_PATH=... 再 source 本文件
#   3. 也可在 ~/.bashrc 中写入 TOOLCHAIN_PATH 实现全局配置

# -------- 项目根目录（自动推导）--------
export PROJECT_DIR=${PROJECT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}

# -------- 工具链 --------
# 优先级: 外部环境变量 > 默认路径
if [ -z "$TOOLCHAIN_PATH" ]; then
    # 默认路径（换机器/换版本时改这里或设外部变量）
    export TOOLCHAIN_PATH=$HOME/orangepi-build/toolchains/gcc-arm-11.2-2022.02-x86_64-aarch64-none-linux-gnu
fi
export PATH=$TOOLCHAIN_PATH/bin:$PATH
export CROSS_COMPILE=aarch64-none-linux-gnu-
export ARCH=arm64

# -------- 内核 --------
export KERNEL_VERSION=6.1.43
export KERNEL_SRC=/opt/linux-orangepi

# -------- 构建 --------
export BUILD_TYPE=release
export INSTALL_DIR=${INSTALL_DIR:-$PROJECT_DIR/output}

# -------- 平台 --------
export PLATFORM=rk3588
export BOARD=orangerpi5plus

# -------- 日志 --------
export LOG_ENABLE_DEBUG=1   # 1=启用DEBUG日志, 0=关闭（编译时裁剪）
